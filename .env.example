# ==============================================================================
# Cisco ACI + Groq + MCP + GitOps Configuration
# ==============================================================================

# Groq API Credentials
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cisco DevNet Always-On ACI Sandbox Credentials
APIC_URL=https://sandboxapicdc.cisco.com
APIC_USERNAME=admin
APIC_PASSWORD=!v3G@!4@Y
APIC_VERIFY_SSL=false

# Fabric Mode: "mock" (recommended for deterministic live demos & offline use)
# or "live" (connects directly to Cisco DevNet APIC Sandbox with automatic fallback)
ACI_MODE=mock

# Server Port for Next.js Web UI & API
APP_PORT=3300
