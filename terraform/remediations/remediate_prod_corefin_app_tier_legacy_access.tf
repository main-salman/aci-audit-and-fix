data "aci_tenant" "prod_corefin" {
  name = "Prod-CoreFin"
}

# 1. Enforce VRF Policy Control & Ensure vzAny (Any-to-Any) Is Removed
resource "aci_vrf" "prod_corefin_vrf" {
  tenant_dn              = data.aci_tenant.prod_corefin.id
  name                   = "Prod-CoreFin-VRF"
  pc_enf_pref            = "enforced"
  pc_enf_dir             = "ingress"
  description            = "Zero-Trust Enforced VRF — vzAny disabled via GitOps remediation"
}

# 2. Scoped Stateful ACI Filter (Flt-App-Tier-Legacy-Access-ZeroTrust)
resource "aci_filter" "app_tier_legacy_access_filter" {
  tenant_dn   = data.aci_tenant.prod_corefin.id
  name        = "Flt-App-Tier-Legacy-Access-ZeroTrust"
  description = "Least-privilege filter replacing permissive/cleartext policy"
}

resource "aci_filter_entry" "app_tier_legacy_access_https_443" {
  filter_dn     = aci_filter.app_tier_legacy_access_filter.id
  name          = "https-443"
   description   = "Managed by GitOps Guardrail — Explicit least-privilege port TCP/443"
  ether_t       = "ip"
  prot          = "tcp"
  d_from_port   = "443"
  d_to_port     = "443"
  stateful      = "yes"
}

resource "aci_filter_entry" "app_tier_legacy_access_https_8443" {
  filter_dn     = aci_filter.app_tier_legacy_access_filter.id
  name          = "https-8443"
   description   = "Managed by GitOps Guardrail — Explicit least-privilege port TCP/8443"
  ether_t       = "ip"
  prot          = "tcp"
  d_from_port   = "8443"
  d_to_port     = "8443"
  stateful      = "yes"
}

# 3. Scoped Contract & Subject (App-Tier-Legacy-Access)
resource "aci_contract" "app_tier_legacy_access" {
  tenant_dn   = data.aci_tenant.prod_corefin.id
  name        = "App-Tier-Legacy-Access"
  scope       = "context"
  description = "Remediated least-privilege contract between Web-Frontend-EPG and Payment-App-EPG"
}

resource "aci_contract_subject" "app_tier_legacy_access_subject" {
  contract_dn                  = aci_contract.app_tier_legacy_access.id
  name                         = "Subj-App-Tier-Legacy-Access-Restricted"
  rev_flt_ports                = "yes"
  relation_vz_rs_subj_filt_att = [aci_filter.app_tier_legacy_access_filter.id]
}

# 4. Explicit EPG Provider & Consumer Contract Bindings (Replacing vzAny)
resource "aci_epg_to_contract" "app_tier_legacy_access_provider" {
  application_epg_dn = "uni/tn-Prod-CoreFin/ap-AP-OnlineBanking/epg-Payment-App-EPG"
  contract_dn        = aci_contract.app_tier_legacy_access.id
  contract_type      = "provider"
}

resource "aci_epg_to_contract" "app_tier_legacy_access_consumer" {
  application_epg_dn = "uni/tn-Prod-CoreFin/ap-AP-OnlineBanking/epg-Web-Frontend-EPG"
  contract_dn        = aci_contract.app_tier_legacy_access.id
  contract_type      = "consumer"
}
